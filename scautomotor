<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SC Automotor | Zárate</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #111111;
            color: white;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 25px;
        }

        .contenedor {
            width: 100%;
            max-width: 420px;
            text-align: center;
        }

        .logo {
            width: 100px;
            height: 100px;
            margin: 0 auto 20px;
            border-radius: 50%;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #111111;
            font-size: 24px;
            font-weight: bold;
        }

        h1 {
            margin: 0;
            font-size: 32px;
        }

        .subtitulo {
            color: #bbbbbb;
            margin-top: 8px;
            margin-bottom: 30px;
        }

        .boton {
            display: block;
            width: 100%;
            padding: 17px;
            margin: 14px 0;
            border-radius: 14px;
            text-decoration: none;
            color: white;
            font-size: 17px;
            font-weight: bold;
            transition: 0.2s;
        }

        .boton:hover {
            transform: scale(1.02);
        }

        .whatsapp {
            background: #25D366;
        }

        .instagram {
            background: #E1306C;
        }

        .ubicacion {
            background: #444444;
        }

        .direccion {
            margin-top: 25px;
            color: #bbbbbb;
            font-size: 15px;
            line-height: 1.5;
        }

        .footer {
            margin-top: 30px;
            color: #777777;
            font-size: 13px;
        }
    </style>
</head>

<body>

    <div class="contenedor">

        <div class="logo">
            SC
        </div>

        <h1>SC Automotor</h1>

        <div class="subtitulo">
            Mecánica automotriz
        </div>

        <!-- WhatsApp -->
        <a
            class="boton whatsapp"
            href="https://wa.me/5493487568102"
            target="_blank">
            🟢 WhatsApp
        </a>

        <!-- Instagram -->
        <a
            class="boton instagram"
            href="https://www.instagram.com/mecanica.automotorsc/"
            target="_blank">
            📸 Instagram
        </a>

        <!-- Ubicación -->
        <a
            class="boton ubicacion"
            href="https://www.google.com/maps/search/?api=1&query=Avenida+Gallesio+655,+Zarate,+Buenos+Aires"
            target="_blank">
            📍 Cómo llegar
        </a>

        <div class="direccion">
            Avenida Gallesio 655<br>
            Zárate, Buenos Aires
        </div>

        <div class="footer">
            © SC Automotor
        </div>

    </div>

</body>
</html>
